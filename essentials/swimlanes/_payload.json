Unassigned', fn (Builder $query): Builder => $query->whereDoesntHave('assignees'))\n        ->moveUsing(function (Task $card, Lane $from, Lane $to): void {\n            if ($from->getName() !== Grouping::EMPTY_LANE) {\n                $card->assignees()->detach($from->getName());\n            }\n\n            if ($to->getName() !== Grouping::EMPTY_LANE) {\n                $card->assignees()->syncWithoutDetaching([$to->getName()]);\n            }\n        }),\n])\n","php","",[86,109,110,143,167,187,205,212,225,253,258,280,300,345,385,431,449,468,478,524,541,560,598,612,651,657,668,723,772,808,837,843,848,875,903,908,914],{"__ignoreMap":107},[111,112,115,119,123,127,130,132,135,137,140],"span",{"class":113,"line":114},"line",1,[111,116,118],{"class":117},"sbssI","use",[111,120,122],{"class":121},"sTEyZ"," Illuminate",[111,124,126],{"class":125},"sMK4o","\\",[111,128,129],{"class":121},"Database",[111,131,126],{"class":125},[111,133,134],{"class":121},"Eloquent",[111,136,126],{"class":125},[111,138,139],{"class":121},"Builder",[111,141,142],{"class":125},";\n",[111,144,146,148,150,152,155,157,160,162,165],{"class":113,"line":145},2,[111,147,118],{"class":117},[111,149,122],{"class":121},[111,151,126],{"class":125},[111,153,154],{"class":121},"Support",[111,156,126],{"class":125},[111,158,159],{"class":121},"Facades",[111,161,126],{"class":125},[111,163,164],{"class":121},"DB",[111,166,142],{"class":125},[111,168,170,172,175,177,180,182,185],{"class":113,"line":169},3,[111,171,118],{"class":117},[111,173,174],{"class":121}," Relaticle",[111,176,126],{"class":125},[111,178,179],{"class":121},"Flowforge",[111,181,126],{"class":125},[111,183,184],{"class":121},"Grouping",[111,186,142],{"class":125},[111,188,190,192,194,196,198,200,203],{"class":113,"line":189},4,[111,191,118],{"class":117},[111,193,174],{"class":121},[111,195,126],{"class":125},[111,197,179],{"class":121},[111,199,126],{"class":125},[111,201,202],{"class":121},"Lane",[111,204,142],{"class":125},[111,206,20