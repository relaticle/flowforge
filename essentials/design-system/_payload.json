mmunity\u002Fcontributing","4.community\u002F1.contributing","i-lucide-heart-handshake",{"title":71,"path":72,"stem":73,"icon":74},"License","\u002Fcommunity\u002Flicense","4.community\u002F2.license","i-lucide-scale",{"id":76,"title":56,"body":77,"description":1703,"extension":1704,"links":1705,"meta":1706,"navigation":1707,"path":57,"seo":1708,"stem":58,"__hash__":1710},"docs\u002F2.essentials\u002F7.design-system.md",{"type":78,"value":79,"toc":1691},"minimark",[80,84,92,97,112,115,198,208,227,230,234,249,256,796,813,816,851,855,865,1058,1064,1068,1075,1174,1191,1195,1198,1342,1345,1351,1356,1362,1431,1444,1448,1472,1475,1490,1535,1658,1668,1672,1684,1687],[81,82,83],"p",{},"A Modern board is styled through a public contract: CSS variables, class hooks and data attributes. Everything on this page is public API. Anything not listed here is internal and can change in any release.",[81,85,86,87,91],{},"The contract applies to Modern boards only. Classic boards keep their ",[88,89,90],"code",{},"flowforge-*"," classes and are not affected by anything below.",[93,94,96],"h2",{"id":95},"layering","Layering",[81,98,99,100,103,104,107,108,111],{},"Flowforge ships plain CSS. It contains no Tailwind utilities and no ",[88,101,102],{},"@apply",", so your app needs no ",[88,105,106],{},"@source"," line and a Tailwind ",[88,109,110],{},"prefix()"," cannot break it.",[81,113,114],{},"The stylesheet opens with the layer order Filament uses, and puts every rule in one sublayer:",[116,117,122],"pre",{"className":118,"code":119,"language":120,"meta":121,"style":121},"language-css shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@layer properties, theme, base, components, utilities;\n\n@layer components.flowforge {\n    \u002F* every rule *\u002F\n}\n","css","",[88,123,124,162,169,185,192],{"__ignoreMap":121},[125,126,129,133,137,141,144,146,149,151,154,156,159],"span",{"class":127,"line":128},"line",1,[125,130,132],{"class":131},"s7zQu","@layer",[125,134,136],{"class":135},"sHdIc"," properties",[125,138,140],{"class":139},"sMK4o",",",[125,142,143],{"class":135}," theme",[125,145,140],{"class":139},[125,147,148],{"class":135}," base",[125,150,140],{"class":139},[125,152,153],{"class":135}," components",[125,155,140],{"class":139},[125,157,158],{"class":135}," utilities",[125,160,161],{"class":139},";\n",[125,163,165],{"class":127,"line":164},2,[125,166,168],{"emptyLinePlaceholder":167},true,"\n",[125,170,172,174,176,179,182],{"class":127,"line":171},3,[125,173,132],{"class":131},[125,175,153],{"class":135},[125,177,178],{"class":139},".",[125,180,181],{"class":135},"flowforge",[125,183,184],{"class":139}," {\n",[125,186,188],{"class":127,"line":187},4,[125,189,191],{"class":190},"sHwdD","    \u002F* every rule *\u002F\n",[125,193,195],{"class":127,"line":194},5,[125,196,197],{"class":139},"}\n",[81,199,200,201,204,205,178],{},"Your unlayered CSS always beats flowforge's. Your layered CSS wins when it sits in ",[88,202,203],{},"components"," itself or in a later layer such as ",[88,206,207],{},"utilities",[81,209,210,211,213,214,217,218,221,222,178],{},"Filament's own component styles sit in ",[88,212,203],{},", which outranks the ",[88,215,216],{},"components.flowforge"," sublayer. Flowforge uses ",[88,219,220],{},"!important"," in the few places it must beat them. See ",[223,224,226],"a",{"href":225},"#properties-set-with-important","Properties set with !important",[81,228,229],{},"Filament panels get the stylesheet in the page head. A standalone board links it in its own markup. You do not register or import it.",[93,231,233],{"id":232},"variables","Variables",[81,235,236,237,240,241,244,245,248],{},"Flowforge never sets a public ",[88,238,239],{},"--ff-*"," variable. Each rule reads the variable through a private alias with a default, so a value you set at any scope wins. That scope can be ",[88,242,243],{},":root",", ",[88,246,247],{},".ff-board"," or one card.",[81,250,251,252,255],{},"The dark column shows where the default changes under Filament's ",[88,253,254],{},".dark"," class. A single value applies to both modes.",[257,258,259,281],"table",{},[260,261,262],"thead",{},[263,264,265,269,272,275,278],"tr",{},[266,267,268],"th",{},"Variable",[266,270,271],{},"Tier",[266,273,274],{},"Default (light \u002F dark)",[266,276,277],{},"Since",[266,279,280],{},"Used for",[282,283,284,310,336,362,387,407,429,448,470,489,511,533,552,571,590,610,628,647,665,683,702,721,739,758,777],"tbody",{},[263,285,286,292,295,304,307],{},[287,288,289],"td",{},[88,290,291],{},"--ff-surface",[287,293,294],{},"semantic",[287,296,297,300,301],{},[88,298,299],{},"var(--gray-50)"," \u002F ",[88,302,303],{},"var(--gray-950)",[287,305,306],{},"4.2.0",[287,308,309],{},"Background of the sticky column-header strip in the lane view. Set it to the page background.",[263,311,312,317,319,327,329],{},[287,313,314],{},[88,315,316],{},"--ff-surface-sunken",[287,318,294],{},[287,320,321,300,324],{},[88,322,323],{},"var(--gray-100)",[88,325,326],{},"color-mix(in oklab, #fff 5%, transparent)",[287,328,306],{},[287,330,331,332,335],{},"Background of a column tray and of a lane cell. ",[88,333,334],{},"--ff-tray-bg"," overrides it.",[263,337,338,343,345,353,355],{},[287,339,340],{},[88,341,342],{},"--ff-surface-raised",[287,344,294],{},[287,346,347,300,350],{},[88,348,349],{},"#fff",[88,351,352],{},"var(--gray-900)",[287,354,306],{},[287,356,357,358,361],{},"Background of a card and of the filters panel. ",[88,359,360],{},"--ff-card-bg"," overrides it for cards.",[263,363,364,369,371,379,381],{},[287,365,366],{},[88,367,368],{},"--ff-border",[287,370,294],{},[287,372,373,300,376],{},[88,374,375],{},"color-mix(in oklab, var(--gray-950) 5%, transparent)",[88,377,378],{},"color-mix(in oklab, #fff 10%, transparent)",[287,380,306],{},[287,382,383,384,361],{},"Ring around a card and around the filters panel. ",[88,385,386],{},"--ff-card-ring",[263,388,389,394,396,402,404],{},[287,390,391],{},[88,392,393],{},"--ff-text",[287,395,294],{},[287,397,398,300,400],{},[88,399,303],{},[88,401,349],{},[287,403,306],{},[287,405,406],{},"Column titles, lane titles, card titles and the add row on hover.",[263,408,409,414,416,424,426],{},[287,410,411],{},[88,412,413],{},"--ff-text-muted",[287,415,294],{},[287,417,418,300,421],{},[88,419,420],{},"var(--gray-500)",[88,422,423],{},"var(--gray-400)",[287,425,306],{},[287,427,428],{},"Secondary text and icons: the group-by label, column icons, counts, summaries, tags, card meta, the add row, the avatar overflow, lane counts and icons, and the header subheading.",[263,430,431,436,438,443,445],{},[287,432,433],{},[88,434,435],{},"--ff-accent",[287,437,294],{},[287,439,440],{},[88,441,442],{},"var(--primary-500)",[287,444,306],{},[287,446,447],{},"Outline of an accepting drop target, the drop gap border and the loading text.",[263,449,450,455,457,465,467],{},[287,451,452],{},[88,453,454],{},"--ff-accent-tint",[287,456,294],{},[287,458,459,300,462],{},[88,460,461],{},"var(--primary-50)",[88,463,464],{},"color-mix(in oklab, var(--primary-500) 10%, transparent)",[287,466,306],{},[287,468,469],{},"Fill of a tray or lane cell that accepts the card.",[263,471,472,477,479,484,486],{},[287,473,474],{},[88,475,476],{},"--ff-danger",[287,478,294],{},[287,480,481],{},[88,482,483],{},"var(--danger-500)",[287,485,306],{},[287,487,488],{},"Outline of a refusing tray or lane cell, and the limit hint.",[263,490,491,496,498,506,508],{},[287,492,493],{},[88,494,495],{},"--ff-warning",[287,497,294],{},[287,499,500,300,503],{},[88,501,502],{},"var(--warning-600)",[88,504,505],{},"var(--warning-400)",[287,507,306],{},[287,509,510],{},"Count of a full column.",[263,512,513,518,520,525,527],{},[287,514,515],{},[88,516,517],{},"--ff-radius",[287,519,294],{},[287,521,522],{},[88,523,524],{},"0.75rem",[287,526,306],{},[287,528,529,530,178],{},"Card radius. The tray and lane cell radius is this plus ",[88,531,532],{},"0.25rem",[263,534,535,540,542,547,549],{},[287,536,537],{},[88,538,539],{},"--ff-gap",[287,541,294],{},[287,543,544],{},[88,545,546],{},"1.25rem",[287,548,306],{},[287,550,551],{},"Space between columns, on the flat board and in the lane grid.",[263,553,554,559,561,566,568],{},[287,555,556],{},[88,557,558],{},"--ff-ease",[287,560,294],{},[287,562,563],{},[88,564,565],{},"cubic-bezier(0.16, 1, 0.3, 1)",[287,567,306],{},[287,569,570],{},"Easing of tray and cell fills, add row color, card shadow and card action fades.",[263,572,573,578,580,585,587],{},[287,574,575],{},[88,576,577],{},"--ff-duration",[287,579,294],{},[287,581,582],{},[88,583,584],{},"200ms",[287,586,306],{},[287,588,589],{},"Duration of the same transitions.",[263,591,592,597,600,605,607],{},[287,593,594],{},[88,595,596],{},"--ff-column-width",[287,598,599],{},"component",[287,601,602],{},[88,603,604],{},"300px",[287,606,306],{},[287,608,609],{},"Width of a column, and of each column in the lane grid.",[263,611,612,616,618,623,625],{},[287,613,614],{},[88,615,334],{},[287,617,599],{},[287,619,620],{},[88,621,622],{},"var(--ff-surface-sunken)",[287,624,306],{},[287,626,627],{},"Background of a column tray and of a lane cell.",[263,629,630,635,637,642,644],{},[287,631,632],{},[88,633,634],{},"--ff-tray-radius",[287,636,599],{},[287,638,639],{},[88,640,641],{},"calc(var(--ff-radius) + 0.25rem)",[287,643,306],{},[287,645,646],{},"Corner radius of a tray and of a lane cell.",[263,648,649,653,655,660,662],{},[287,650,651],{},[88,652,360],{},[287,654,599],{},[287,656,657],{},[88,658,659],{},"var(--ff-surface-raised)",[287,661,306],{},[287,663,664],{},"Card background.",[263,666,667,671,673,678,680],{},[287,668,669],{},[88,670,386],{},[287,672,599],{},[287,674,675],{},[88,676,677],{},"var(--ff-border)",[287,679,306],{},[287,681,682],{},"Card ring color.",[263,684,685,690,692,697,699],{},[287,686,687],{},[88,688,689],{},"--ff-card-radius",[287,691,599],{},[287,693,694],{},[88,695,696],{},"var(--ff-radius)",[287,698,306],{},[287,700,701],{},"Card corner radius.",[263,703,704,709,711,716,718],{},[287,705,706],{},[88,707,708],{},"--ff-card-shadow",[287,710,599],{},[287,712,713],{},[88,714,715],{},"0 1px 2px 0 rgb(0 0 0 \u002F 0.05)",[287,717,306],{},[287,719,720],{},"Card shadow list. It sets the resting and the hover shadow together.",[263,722,723,728,730,734,736],{},[287,724,725],{},[88,726,727],{},"--ff-card-padding",[287,729,599],{},[287,731,732],{},[88,733,524],{},[287,735,306],{},[287,737,738],{},"Space inside a card.",[263,740,741,746,748,753,755],{},[287,742,743],{},[88,744,745],{},"--ff-drag-tilt",[287,747,599],{},[287,749,750],{},[88,751,752],{},"2.5deg",[287,754,306],{},[287,756,757],{},"Rotation of the card while it is dragged.",[263,759,760,765,767,772,774],{},[287,761,762],{},[88,763,764],{},"--ff-drag-shadow",[287,766,599],{},[287,768,769],{},[88,770,771],{},"0 10px 15px -3px rgb(0 0 0 \u002F 0.1), 0 4px 6px -4px rgb(0 0 0 \u002F 0.1)",[287,773,306],{},[287,775,776],{},"Shadow list of the dragged card.",[263,778,779,784,786,791,793],{},[287,780,781],{},[88,782,783],{},"--ff-placeholder-border",[287,785,599],{},[287,787,788],{},[88,789,790],{},"var(--ff-accent)",[287,792,306],{},[287,794,795],{},"Border of the drop gap.",[81,797,798,799,244,802,244,805,808,809,812],{},"Flowforge also reads the Filament palette: ",[88,800,801],{},"--gray-*",[88,803,804],{},"--primary-*",[88,806,807],{},"--danger-*"," and ",[88,810,811],{},"--warning-*",". It never sets them.",[81,814,815],{},"Notes that apply to several variables:",[817,818,819,834,839,844],"ul",{},[820,821,822,823,826,827,830,831,833],"li",{},"The shadow variables take a shadow list. Use ",[88,824,825],{},"0 0 #0000"," for no shadow, never ",[88,828,829],{},"none",". Flowforge combines the value with a ring, and ",[88,832,829],{}," makes the whole declaration invalid.",[820,835,836,838],{},[88,837,291],{}," paints the sticky lane-header strip behind the column headers. Set it to the background your page uses, so cards scroll under the strip without showing through.",[820,840,841,843],{},[88,842,708],{}," sets the resting shadow and the hover shadow together.",[820,845,846,847,850],{},"The dragged card is a clone on ",[88,848,849],{},"body",". Flowforge copies the variables above from the card you picked up, so a value set at any scope reaches the clone.",[93,852,854],{"id":853},"hooks","Hooks",[81,856,857,858,861,862,864],{},"Hooks are class names. Modern markup carries ",[88,859,860],{},"ff-*"," hooks only. The ",[88,863,90],{}," classes of classic boards never appear in Modern views, so a rule written for one board does not reach the other.",[257,866,867,877],{},[260,868,869],{},[263,870,871,874],{},[266,872,873],{},"Hook",[266,875,876],{},"Element",[282,878,879,889,899,909,919,929,939,949,959,969,979,989,999,1009,1019,1032,1045],{},[263,880,881,886],{},[287,882,883],{},[88,884,885],{},"ff-board",[287,887,888],{},"The board root",[263,890,891,896],{},[287,892,893],{},[88,894,895],{},"ff-columns",[287,897,898],{},"The row that holds the columns of a board without lanes. Set its padding to space the columns from the page edge",[263,900,901,906],{},[287,902,903],{},[88,904,905],{},"ff-column",[287,907,908],{},"One column: its header and its tray. In the lane view it holds only the column header",[263,910,911,916],{},[287,912,913],{},[88,914,915],{},"ff-column-header",[287,917,918],{},"The row with the title, count, summary and actions",[263,920,921,926],{},[287,922,923],{},[88,924,925],{},"ff-count",[287,927,928],{},"The card count in a column header",[263,930,931,936],{},[287,932,933],{},[88,934,935],{},"ff-summary",[287,937,938],{},"The column summary text",[263,940,941,946],{},[287,942,943],{},[88,944,945],{},"ff-tray",[287,947,948],{},"The surface that holds a column's cards. The lane view has no tray, its cells are the surface",[263,950,951,956],{},[287,952,953],{},[88,954,955],{},"ff-card",[287,957,958],{},"One card",[263,960,961,966],{},[287,962,963],{},[88,964,965],{},"ff-card-actions",[287,967,968],{},"The action menu in a card's corner",[263,970,971,976],{},[287,972,973],{},[88,974,975],{},"ff-add-row",[287,977,978],{},"The add-card row, the \"Show more cards\" button in a lane cell and the \"Show more lanes\" button",[263,980,981,986],{},[287,982,983],{},[88,984,985],{},"ff-lanes",[287,987,988],{},"The root of the lane view",[263,990,991,996],{},[287,992,993],{},[88,994,995],{},"ff-lane-header",[287,997,998],{},"The header of one lane. It stays at the left edge while the lanes scroll sideways, and a click collapses or expands the lane",[263,1000,1001,1006],{},[287,1002,1003],{},[88,1004,1005],{},"ff-cell",[287,1007,1008],{},"One lane and column intersection, a drop target",[263,1010,1011,1016],{},[287,1012,1013],{},[88,1014,1015],{},"ff-limit-hint",[287,1017,1018],{},"The hint shown over a full column's tray during a drag. The lane view does not render it",[263,1020,1021,1026],{},[287,1022,1023],{},[88,1024,1025],{},"ff-card-tag",[287,1027,1028,1029],{},"One tag from ",[88,1030,1031],{},"CardTag",[263,1033,1034,1039],{},[287,1035,1036],{},[88,1037,1038],{},"ff-card-meta",[287,1040,1041,1042],{},"The row of entries from ",[88,1043,1044],{},"CardMeta",[263,1046,1047,1052],{},[287,1048,1049],{},[88,1050,1051],{},"ff-card-avatar",[287,1053,1054,1055],{},"One avatar from ",[88,1056,1057],{},"CardAvatar",[81,1059,1060,1061,1063],{},"Other ",[88,1062,860],{}," classes exist for layout. They are internal.",[93,1065,1067],{"id":1066},"states","States",[81,1069,1070,1071,1074],{},"Flowforge reports state through data attributes. SortableJS toggles classes only, so ",[88,1072,1073],{},"flowforge-modern.js"," mirrors its states into these attributes.",[257,1076,1077,1090],{},[260,1078,1079],{},[263,1080,1081,1084,1087],{},[266,1082,1083],{},"Attribute",[266,1085,1086],{},"On",[266,1088,1089],{},"Meaning",[282,1091,1092,1105,1118,1135,1148,1161],{},[263,1093,1094,1099,1102],{},[287,1095,1096],{},[88,1097,1098],{},"data-dragging",[287,1100,1101],{},"The dragged card clone",[287,1103,1104],{},"A drag is in progress",[263,1106,1107,1112,1115],{},[287,1108,1109],{},[88,1110,1111],{},"data-placeholder",[287,1113,1114],{},"The drop gap",[287,1116,1117],{},"Where the card will land",[263,1119,1120,1129,1132],{},[287,1121,1122,1125,1126],{},[88,1123,1124],{},"data-drop=\"active\""," or ",[88,1127,1128],{},"data-drop=\"blocked\"",[287,1130,1131],{},"A column, or a lane cell",[287,1133,1134],{},"The hovered target accepts or refuses the card",[263,1136,1137,1142,1145],{},[287,1138,1139],{},[88,1140,1141],{},"data-full",[287,1143,1144],{},"A column",[287,1146,1147],{},"The column is at its limit",[263,1149,1150,1155,1158],{},[287,1151,1152],{},[88,1153,1154],{},"data-collapsed",[287,1156,1157],{},"A column, or a lane header",[287,1159,1160],{},"The column shows as a collapsed rail, or the lane's cells are hidden",[263,1162,1163,1168,1171],{},[287,1164,1165],{},[88,1166,1167],{},"data-pending",[287,1169,1170],{},"A card",[287,1172,1173],{},"Its move is saving",[81,1175,1176,1177,1179,1180,1182,1183,1186,1187,1190],{},"The dragged clone sits on ",[88,1178,849],{},", outside ",[88,1181,247],{},". A rule that must reach it starts at ",[88,1184,1185],{},".ff-card[data-dragging]",", and the visible card is its ",[88,1188,1189],{},".ff-card-body"," child.",[93,1192,1194],{"id":1193},"customizing","Customizing",[81,1196,1197],{},"Set variables in your theme and add hook rules beside them:",[116,1199,1201],{"className":118,"code":1200,"language":120,"meta":121,"style":121},":root { --ff-accent: var(--primary-600); --ff-radius: .5rem; --ff-drag-tilt: 1.5deg; }\n.dark { --ff-card-bg: var(--gray-900); }\n.ff-column[data-drop=\"blocked\"] .ff-tray { outline: 2px dashed var(--ff-danger); }\n",[88,1202,1203,1259,1285],{"__ignoreMap":121},[125,1204,1205,1208,1212,1215,1219,1221,1225,1228,1231,1234,1237,1239,1243,1246,1249,1251,1254,1256],{"class":127,"line":128},[125,1206,1207],{"class":139},":",[125,1209,1211],{"class":1210},"spNyl","root",[125,1213,1214],{"class":139}," {",