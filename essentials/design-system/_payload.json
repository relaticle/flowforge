,"properties-set-with-important",[81,1537,1538,1539,1541,1542,1544,1545,1547,1548,1550],{},"Flowforge sets these properties with ",[88,1540,220],{},", to beat Filament component styles that outrank its sublayer. To override one, put your own ",[88,1543,220],{}," rule in an earlier layer, because cascade layers reverse the order for ",[88,1546,220],{},". An unlayered or later-layer ",[88,1549,220],{}," rule loses to flowforge's layered one.",[116,1552,1554],{"className":118,"code":1553,"language":120,"meta":121,"style":121},"@layer base {\n    .ff-card-meta .fi-badge { color: red !important; }\n}\n",[88,1555,1556,1564,1592],{"__ignoreMap":121},[125,1557,1558,1560,1562],{"class":127,"line":128},[125,1559,132],{"class":131},[125,1561,148],{"class":135},[125,1563,184],{"class":139},[125,1565,1566,1569,1571,1573,1576,1578,1581,1583,1586,1588,1590],{"class":127,"line":164},[125,1567,1568],{"class":139},"    .",[125,1570,1099],{"class":1326},[125,1572,1375],{"class":139},[125,1574,1575],{"class":1326},"fi-badge",[125,1577,1275],{"class":139},[125,1579,1580],{"class":1382}," color",[125,1582,1268],{"class":139},[125,1584,1585],{"class":1278}," red ",[125,1587,220],{"class":1302},[125,1589,1306],{"class":139},[125,1591,1319],{"class":139},[125,1593,1594],{"class":127,"line":171},[125,1595,197],{"class":139},[257,1597,1598,1608],{},[260,1599,1600],{},[263,1601,1602,1605],{},[266,1603,1604],{},"Selector",[266,1606,1607],{},"Properties",[282,1609,1610,1634,1648,1665,1677,1689,1708],{},[263,1611,1612,1617],{},[287,1613,1614],{},[88,1615,1616],{},".ff-card-meta .fi-badge",[287,1618,1619,244,1622,244,1625,244,1628,244,1631],{},[88,1620,1621],{},"padding",[88,1623,1624],{},"font-weight",[88,1626,1627],{},"color",[88,1629,1630],{},"background",[88,1632,1633],{},"box-shadow",[263,1635,1636,1641],{},[287,1637,1638],{},[88,1639,1640],{},".ff-card-meta .fi-in-text-item",[287,1642,1643,244,1646],{},[88,1644,1645],{},"font-size",[88,1647,1627],{},[263,1649,1650,1655],{},[287,1651,1652],{}