mmunity\u002Fcontributing","4.community\u002F1.contributing","i-lucide-heart-handshake",{"title":71,"path":72,"stem":73,"icon":74},"License","\u002Fcommunity\u002Flicense","4.community\u002F2.license","i-lucide-scale",{"id":76,"title":56,"body":77,"description":1764,"extension":1765,"links":1766,"meta":1767,"navigation":1768,"path":57,"seo":1769,"stem":58,"__hash__":1771},"docs\u002F2.essentials\u002F7.design-system.md",{"type":78,"value":79,"toc":1752},"minimark",[80,84,92,97,112,115,198,208,227,230,234,249,256,857,874,877,912,916,926,1119,1125,1129,1136,1235,1252,1256,1259,1403,1406,1412,1417,1423,1492,1505,1509,1533,1536,1551,1596,1719,1729,1733,1745,1748],[81,82,83],"p",{},"A Modern board is styled through a public contract: CSS variables, class hooks and data attributes. Everything on this page is public API. Anything not listed here is internal and can change in any release.",[81,85,86,87,91],{},"The contract applies to Modern boards only. Classic boards keep their ",[88,89,90],"code",{},"flowforge-*"," classes and are not affected by anything below.",[93,94,96],"h2",{"id":95},"layering","Layering",[81,98,99,100,103,104,107,108,111],{},"Flowforge ships plain CSS. It contains no Tailwind utilities and no ",[88,101,102],{},"@apply",", so your app needs no ",[88,105,106],{},"@source"," line and a Tailwind ",[88,109,110],{},"prefix()"," cannot break it.",[81,113,114],{},"The stylesheet opens with the layer order Filament uses, and puts every rule in one sublayer:",[116,117,122],"pre",{"className":118,"code":119,"language":120,"meta":121,"style":121},"language-css shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@layer properties, theme, base, components, utilities;\n\n@layer components.flowforge {\n    \u002F* every rule *\u002F\n}\n","css","",[88,123,124,162,169,185,192],{"__ignoreMap":121},[125,126,129,133,137,141,144,146,149,151,154,156,159],"span",{"class":127,"line":128},"line",1,[125,130,132],{"class":131},"s7zQu","@layer",[125,134,136],{"class":135},"sHdIc"," properties",[125,138,140],{"class":139},"sMK4o",",",[125,142,143],{"class":135}," theme",[125,145,140],{"class":139},[125,147,148],{"class":135}," base",[125,150,140],{"class":139},[125,152,153],{"class":135}," components",[125,155,140],{"class":139},[125,157,158],{"class":135}," utilities",[125,160,161],{"class":139},";\n",[125,163,165],{"class":127,"line":164},2,[125,166,168],{"emptyLinePlaceholder":167},true,"\n",[125,170,172,174,176,179,182],{"class":127,"line":171},3,[125,173,132],{"class":131},[125,175,153],{"class":135},[125,177,178],{"class":139},".",[125,180,181],{"class":135},"flowforge",[125,183,184],{"class":139}," {\n",[125,186,188],{"class":127,"line":187},4,[125,189,191],{"class":190},"sHwdD","    \u002F* every rule *\u002F\n",[125,193,195],{"class":127,"line":194},5,[125,196,197],{"class":139},"}\n",[81,199,200,201,204,205,178],{},"Your unlayered CSS always beats flowforge's. Your layered CSS wins when it sits in ",[88,202,203],{},"components"," itself or in a later layer such as ",[88,206,207],{},"utilities",[81,209,210,211,213,214,217,218,221,222,178],{},"Filament's own component styles sit in ",[88,212,203],{},", which outranks the ",[88,215,216],{},"components.flowforge"," sublayer. Flowforge uses ",[88,219,220],{},"!important"," in the few places it must beat them. See ",[223,224,226],"a",{"href":225},"#properties-set-with-important","Properties set with !important",[81,228,229],{},"Filament panels get the stylesheet in the page head. A standalone board links it in its own markup. You do not register or import it.",[93,231,233],{"id":232},"variables","Variables",[81,235,236,237,240,241,244,245,248],{},"Flowforge never sets a public ",[88,238,239],{},"--ff-*"," variable. Each rule reads the variable through a private alias with a default, so a value you set at any scope wins. That scope can be ",[88,242,243],{},":root",", ",[88,246,247],{},".ff-board"," or one card.",[81,250,251,252,255],{},"The dark column shows where the default changes under Filament's ",[88,253,254],{},".dark"," class. A single value applies to both modes.",[257,258,259,281],"table",{},[260,261,262],"thead",{},[263,264,265,269,272,275,278],"tr",{},[266,267,268],"th",{},"Variable",[266,270,271],{},"Tier",[266,273,274],{},"Default (light \u002F dark)",[266,276,277],{},"Since",[266,279,280],{},"Used for",[282,283,284,310,336,362,387,407,429,448,470,489,511,533,552,571,590,610,630,648,671,689,708,726,744,763,782,800,819,838],"tbody",{},[263,285,286,292,295,304,307],{},[287,288,289],"td",{},[88,290,291],{},"--ff-surface",[287,293,294],{},"semantic",[287,296,297,300,301],{},[88,298,299],{},"var(--gray-50)"," \u002F ",[88,302,303],{},"var(--gray-950)",[287,305,306],{},"4.2.0",[287,308,309],{},"Background of the sticky column-header strip in the lane view. Set it to the page background.",[263,311,312,317,319,327,329],{},[287,313,314],{},[88,315,316],{},"--ff-surface-sunken",[287,318,294],{},[287,320,321,300,324],{},[88,322,323],{},"var(--gray-100)",[88,325,326],{},"color-mix(in oklab, #fff 5%, transparent)",[287,328,306],{},[287,330,331,332,335],{},"Background of a column tray and of a lane cell. ",[88,333,334],{},"--ff-tray-bg"," overrides it.",[263,337,338,343,345,353,355],{},[287,339,340],{},[88,341,342],{},"--ff-surface-raised",[287,344,294],{},[287,346,347,300,350],{},[88,348,349],{},"#fff",[88,351,352],{},"var(--gray-900)",[287,354,306],{},[287,356,357,358,361],{},"Background of a card and of the filters panel. ",[88,359,360],{},"--ff-card-bg"," overrides it for cards.",[263,363,364,369,371,379,381],{},[287,365,366],{},[88,367,368],{},"--ff-border",[287,370,294],{},[287,372,373,300,376],{},[88,374,375],{},"color-mix(in oklab, var(--gray-950) 5%, transparent)",[88,377,378],{},"color-mix(in oklab, #fff 10%, transparent)",[287,380,306],{},[287,382,383,384,361],{},"Ring around a card and around the filters panel. ",[88,385,386],{},"--ff-card-ring",[263,388,389,394,396,402,404],{},[287,390,391],{},[88,392,393],{},"--ff-text",[287,395,294],{},[287,397,398,300,400],{},[88,399,303],{},[88,401,349],{},[287,403,306],{},[287,405,406],{},"Column titles, lane titles, card titles and the add row on hover.",[263,408,409,414,416,424,426],{},[287,410,411],{},[88,412,413],{},"--ff-text-muted",[287,415,294],{},[287,417,418,300,421],{},[88,419,420],{},"var(--gray-500)",[88,422,423],{},"var(--gray-400)",[287,425,306],{},[287,427,428],{},"Secondary text and icons: the group-by label, column icons, counts, summaries, tags, card meta, the add row, the avatar overflow, lane counts and icons, and the header subheading.",[263,430,431,436,438,443,445],{},[287,432,433],{},[88,434,435],{},"--ff-accent",[287,437,294],{},[287,439,440],{},[88,441,442],{},"var(--primary-500)",[287,444,306],{},[287,446,447],{},"Outline of an accepting drop target, the drop gap border and the loading text.",[263,449,450,455,457,465,467],{},[287,451,452],{},[88,453,454],{},"--ff-accent-tint",[287,456,294],{},[287,458,459,300,462],{},[88,460,461],{},"var(--primary-50)",[88,463,464],{},"color-mix(in oklab, var(--primary-500) 10%, transparent)",[287,466,306],{},[287,468,469],{},"Fill of a tray or lane cell that accepts the card.",[263,471,472,477,479,484,486],{},[287,473,474],{},[88,475,476],{},"--ff-danger",[287,478,294],{},[287,480,481],{},[88,482,483],{},"var(--danger-500)",[287,485,306],{},[287,487,488],{},"Outline of a refusing tray or lane cell, and the limit hint.",[263,490,491,496,498,506,508],{},[287,492,493],{},[88,494,495],{},"--ff-warning",[287,497,294],{},[287,499,500,300,503],{},[88,501,502],{},"var(--warning-600)",[88,504,505],{},"var(--warning-400)",[287,507,306],{},[287,509,510],{},"Count of a full column.",[263,512,513,518,520,525,527],{},[287,514,515],{},[88,516,517],{},"--ff-radius",[287,519,294],{},[287,521,522],{},[88,523,524],{},"0.75rem",[287,526,306],{},[287,528,529,530,178],{},"Card radius. The tray and lane cell radius is this plus ",[88,531,532],{},"0.25rem",[263,534,535,540,542,547,549],{},[287,536,537],{},[88,538,539],{},"--ff-gap",[287,541,294],{},[287,543,544],{},[88,545,546],{},"1.25rem",[287,548,306],{},[287,550,551],{},"Space between columns, on the flat board and in the lane grid.",[263,553,554,559,561,566,568],{},[287,555,556],{},[88,557,558],{},"--ff-ease",[287,560,294],{},[287,562,563],{},[88,564,565],{},"cubic-bezier(0.16, 1, 0.3, 1)",[287,567,306],{},[287,569,570],{},"Easing of tray and cell fills, add row color, card shadow and card action fades.",[263,572,573,578,580,585,587],{},[287,574,575],{},[88,576,577],{},"--ff-duration",[287,579,294],{},[287,581,582],{},[88,583,584],{},"200ms",[287,586,306],{},[287,588,589],{},"Duration of the same transitions.",[263,591,592,597,600,605,607],{},[287,593,594],{},[88,595,596],{},"--ff-column-width",[287,598,599],{},"component",[287,601,602],{},[88,603,604],{},"300px",[287,606,306],{},[287,608,609],{},"Width of a column, and of each column in the lane grid.",[263,611,612,617,619,624,627],{},[287,613,614],{},[88,615,616],{},"--ff-dot-size",[287,618,599],{},[287,620,621],{},[88,622,623],{},"0.5rem",[287,625,626],{},"4.4.0",[287,628,629],{},"Diameter of the color dot in a column header and in the add column field.",[263,631,632,637,639,643,645],{},[287,633,634],{},[88,635,636],{},"--ff-overlay-radius",[287,638,599],{},[287,640,641],{},[88,642,524],{},[287,644,626],{},[287,646,647],{},"Corner radius of the add column form, its name field and the color swatch grid.",[263,649,650,655,657,666,668],{},[287,651,652],{},[88,653,654],{},"--ff-overlay-shadow",[287,656,599],{},[287,658,659,662,663,665],{},[88,660,661],{},"0 0 0 1px color-mix(in oklab, var(--gray-950) 5%, transparent), 0 10px 15px -3px rgb(0 0 0 \u002F 0.1), 0 4px 6px -4px rgb(0 0 0 \u002F 0.1)"," \u002F the same with a ",[88,664,349],{}," 10% ring and a 0.3 shadow",[287,667,626],{},[287,669,670],{},"Ring and shadow list of the add column form and the color swatch grid.",[263,672,673,677,679,684,686],{},[287,674,675],{},[88,676,334],{},[287,678,599],{},[287,680,681],{},[88,682,683],{},"var(--ff-surface-sunken)",[287,685,306],{},[287,687,688],{},"Background of a column tray and of a lane cell.",[263,690,691,696,698,703,705],{},[287,692,693],{},[88,694,695],{},"--ff-tray-radius",[287,697,599],{},[287,699,700],{},[88,701,702],{},"calc(var(--ff-radius) + 0.25rem)",[287,704,306],{},[287,706,707],{},"Corner radius of a tray and of a lane cell.",[263,709,710,714,716,721,723],{},[287,711,712],{},[88,713,360],{},[287,715,599],{},[287,717,718],{},[88,719,720],{},"var(--ff-surface-raised)",[287,722,306],{},[287,724,725],{},"Card background.",[263,727,728,732,734,739,741],{},[287,729,730],{},[88,731,386],{},[287,733,599],{},[287,735,736],{},[88,737,738],{},"var(--ff-border)",[287,740,306],{},[287,742,743],{},"Card ring color.",[263,745,746,751,753,758,760],{},[287,747,748],{},[88,749,750],{},"--ff-card-radius",[287,752,599],{},[287,754,755],{},[88,756,757],{},"var(--ff-radius)",[287,759,306],{},[287,761,762],{},"Card corner radius.",[263,764,765,770,772,777,779],{},[287,766,767],{},[88,768,769],{},"--ff-card-shadow",[287,771,599],{},[287,773,774],{},[88,775,776],{},"0 1px 2px 0 rgb(0 0 0 \u002F 0.05)",[287,778,306],{},[287,780,781],{},"Card shadow list. It sets the resting and the hover shadow together.",[263,783,784,789,791,795,797],{},[287,785,786],{},[88,787,788],{},"--ff-card-padding",[287,790,599],{},[287,792,793],{},[88,794,524],{},[287,796,306],{},[287,798,799],{},"Space inside a card.",[263,801,802,807,809,814,816],{},[287,803,804],{},[88,805,806],{},"--ff-drag-tilt",[287,808,599],{},[287,810,811],{},[88,812,813],{},"2.5deg",[287,815,306],{},[287,817,818],{},"Rotation of the card while it is dragged.",[263,820,821,826,828,833,835],{},[287,822,823],{},[88,824,825],{},"--ff-drag-shadow",[287,827,599],{},[287,829,830],{},[88,831,832],{},"0 10px 15px -3px rgb(0 0 0 \u002F 0.1), 0 4px 6px -4px rgb(0 0 0 \u002F 0.1)",[287,834,306],{},[287,836,837],{},"Shadow list of the dragged card.",[263,839,840,845,847,852,854],{},[287,841,842],{},[88,843,844],{},"--ff-placeholder-border",[287,846,599],{},[287,848,849],{},[88,850,851],{},"var(--ff-accent)",[287,853,306],{},[287,855,856],{},"Border of the drop gap.",[81,858,859,860,244,863,244,866,869,870,873],{},"Flowforge also reads the Filament palette: ",[88,861,862],{},"--gray-*",[88,864,865],{},"--primary-*",[88,867,868],{},"--danger-*"," and ",[88,871,872],{},"--warning-*",". It never sets them.",[81,875,876],{},"Notes that apply to several variables:",[878,879,880,895,900,905],"ul",{},[881,882,883,884,887,888,891,892,894],"li",{},"The shadow variables take a shadow list. Use ",[88,885,886],{},"0 0 #0000"," for no shadow, never ",[88,889,890],{},"none",". Flowforge combines the value with a ring, and ",[88,893,890],{}," makes the whole declaration invalid.",[881,896,897,899],{},[88,898,291],{}," paints the sticky lane-header strip behind the column headers. Set it to the background your page uses, so cards scroll under the strip without showing through.",[881,901,902,904],{},[88,903,769],{}," sets the resting shadow and the hover shadow together.",[881,906,907,908,911],{},"The dragged card is a clone on ",[88,909,910],{},"body",". Flowforge copies the variables above from the card you picked up, so a value set at any scope reaches the clone.",[93,913,915],{"id":914},"hooks","Hooks",[81,917,918,919,922,923,925],{},"Hooks are class names. Modern markup carries ",[88,920,921],{},"ff-*"," hooks only. The ",[88,924,90],{}," classes of classic boards never appear in Modern views, so a rule written for one board does not reach the other.",[257,927,928,938],{},[260,929,930],{},[263,931,932,935],{},[266,933,934],{},"Hook",[266,936,937],{},"Element",[282,939,940,950,960,970,980,990,1000,1010,1020,1030,1040,1050,1060,1070,1080,1093,1106],{},[263,941,942,947],{},[287,943,944],{},[88,945,946],{},"ff-board",[287,948,949],{},"The board root",[263,951,952,957],{},[287,953,954],{},[88,955,956],{},"ff-columns",[287,958,959],{},"The row that holds the columns of a board without lanes. Set its padding to space the columns from the page edge",[263,961,962,967],{},[287,963,964],{},[88,965,966],{},"ff-column",[287,968,969],{},"One column: its header and its tray. In the lane view it holds only the column header",[263,971,972,977],{},[287,973,974],{},[88,975,976],{},"ff-column-header",[287,978,979],{},"The row with the title, count, summary and actions",[263,981,982,987],{},[287,983,984],{},[88,985,986],{},"ff-count",[287,988,989],{},"The card count in a column header",[263,991,992,997],{},[287,993,994],{},[88,995,996],{},"ff-summary",[287,998,999],{},"The column summary text",[263,1001,1002,1007],{},[287,1003,1004],{},[88,1005,1006],{},"ff-tray",[287,1008,1009],{},"The surface that holds a column's cards. The lane view has no tray, its cells are the surface",[263,1011,1012,1017],{},[287,1013,1014],{},[88,1015,1016],{},"ff-card",[287,1018,1019],{},"One card",[263,1021,1022,1027],{},[287,1023,1024],{},[88,1025,1026],{},"ff-card-actions",[287,1028,1029],{},"The action menu in a card's corner",[263,1031,1032,1037],{},[287,1033,1034],{},[88,1035,1036],{},"ff-add-row",[287,1038,1039],{},"The add-card row, the \"Show more cards\" button in a lane cell and the \"Show more lanes\" button",[263,1041,1042,1047],{},[287,1043,1044],{},[88,1045,1046],{},"ff-lanes",[287,1048,1049],{},"The root of the lane view",[263,1051,1052,1057],{},[287,1053,1054],{},[88,1055,1056],{},"ff-lane-header",[287,1058,1059],{},"The header of one lane. It stays at the left edge while the lanes scroll sideways, and a click collapses or expands the lane",[263,1061,1062,1067],{},[287,1063,1064],{},[88,1065,1066],{},"ff-cell",[287,1068,1069],{},"One lane and column intersection, a drop target",[263,1071,1072,1077],{},[287,1073,1074],{},[88,1075,1076],{},"ff-limit-hint",[287,1078,1079],{},"The hint shown over a full column's tray during a drag. The lane view does not render it",[263,1081,1082,1087],{},[287,1083,1084],{},[88,1085,1086],{},"ff-card-tag",[287,1088,1089,1090],{},"One tag from ",[88,1091,1092],{},"CardTag",[263,1094,1095,1100],{},[287,1096,1097],{},[88,1098,1099],{},"ff-card-meta",[287,1101,1102,1103],{},"The row of entries from ",[88,1104,1105],{},"CardMeta",[263,1107,1108,1113],{},[287,1109,1110],{},[88,1111,1112],{},"ff-card-avatar",[287,1114,1115,1116],{},"One avatar from ",[88,1117,1118],{},"CardAvatar",[81,1120,1121,1122,1124],{},"Other ",[88,1123,921],{}," classes exist for layout. They are internal.",[93,1126,1128],{"id":1127},"states","States",[81,1130,1131,1132,1135],{},"Flowforge reports state through data attributes. SortableJS toggles classes only, so ",[88,1133,1134],{},"flowforge-modern.js"," mirrors its states into these attributes.",[257,1137,1138,1151],{},[260,1139,1140],{},[263,1141,1142,1145,1148],{},[266,1143,1144],{},"Attribute",[266,1146,1147],{},"On",[266,1149,1150],{},"Meaning",[282,1152,1153,1166,1179,1196,1209,1222],{},[263,1154,1155,1160,1163],{},[287,1156,1157],{},[88,1158,1159],{},"data-dragging",[287,1161,1162],{},"The dragged card clone",[287,1164,1165],{},"A drag is in progress",[263,1167,1168,1173,1176],{},[287,1169,1170],{},[88,1171,1172],{},"data-placeholder",[287,1174,1175],{},"The drop gap",[287,1177,1178],{},"Where the card will land",[263,1180,1181,1190,1193],{},[287,1182,1183,1186,1187],{},[88,1184,1185],{},"data-drop=\"active\""," or ",[88,1188,1189],{},"data-drop=\"blocked\"",[287,1191,1192],{},"A column, or a lane cell",[287,1194,1195],{},"The hovered target accepts or refuses the card",[263,1197,1198,1203,1206],{},[287,1199,1200],{},[88,1201,1202],{},"data-full",[287,1204,1205],{},"A column",[287,1207,1208],{},"The column is at its limit",[263,1210,1211,1216,1219],{},[287,1212,1213],{},[88,1214,1215],{},"data-collapsed",[287,1217,1218],{},"A column, a lane header, or a lane cell",[287,1220,1221],{},"The column shows as a collapsed rail, the lane's cells are hidden, or the cell sits under a collapsed column and shows its count only",[263,1223,1224,1229,1232],{},[287,1225,1226],{},[88,1227,1228],{},"data-pending",[287,1230,1231],{},"A card",[287,1233,1234],{},"Its move is saving",[81,1236,1237,1238,1240,1241,1243,1244,1247,1248,1251],{},"The dragged clone sits on ",[88,1239,910],{},", outside ",[88,1242,247],{},". A rule that must reach it starts at ",[88,1245,1246],{},".ff-card[data-dragging]",", and the visible card is its ",[88,1249,1250],{},".ff-card-body"," child.",[93,1253,1255],{"id":1254},"customizing","Customizing",[81,1257,1258],{},"Set variables in your theme and add hook rules beside them:",[116,1260,1262],{"className":118,"code":1261,"language":120,"meta":121,"style":121},":root { --ff-accent: var(--primary-600); --ff-radius: .5rem; --ff-drag-tilt: 1.5deg; }\n.dark { --ff-card-bg: var(--gray-900); }\n.ff-column[data-drop=\"blocked\"] .ff-tray { outline: 2px dashed var(--ff-danger); }\n",[88,1263,1264,1320,1346],{"__ignoreMap":121},[125,1265,1266,1269,1273,1276,1280,1282,1286,1289,1292,1295,1298,1300,1304,1307,1310,1312,1315,1317],{"class":127,"line":128},[125,1267,1268],{"class":139},":",[125,1270,1272],{"class":1271},"spNyl","root",[125,1274,1275],{"class":139}," {",[125,1277,1279],{"class":1278},"sTEyZ"," --ff-accent",[125,1281,1268],{"class":139},[125,1283,1285],{"class":1284},"s2Zo4"," var",[125,1287,1288],{"class":139},"(",[125,1290,1291],{"class":1278},"--primary-600",[125,1293,1294],{"class":139},");",[125,1296,1297],{"class":1278}," --ff-radius",[125,1299,1268],{"class":139},[125,1301,1303],{"class":1302},"sbssI"," .5rem",[125,1305,1306],{"class":139},";",[125,1308,1309],{"class":1278}," --ff-drag-tilt",[125,1311,1268],{"class":139},[125,1313,1314],{"class":1302}," 1.5deg",[125,1316,1306],{"class":139},[125,1318,1319],{"class":139}," }\n",[125,1321,1322,1324,1328,1330,1333,1335,1337,1339,1342,1344],{"class":127,"line":164},[125,1323,178],{"class":139},[125,1325,1327],{"class":1326},"sBMFI","dark",[125,1329,1275],{"class":139},[125,1331,1332],{"class":1278}," --ff-card-bg",[125,1334,1268],{"class":139},[125,