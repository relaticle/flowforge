community\u002Fcontributing","4.community\u002F1.contributing","i-lucide-heart-handshake",{"title":71,"path":72,"stem":73,"icon":74},"License","\u002Fcommunity\u002Flicense","4.community\u002F2.license","i-lucide-scale",{"id":76,"title":16,"body":77,"description":1711,"extension":1712,"links":1713,"meta":1714,"navigation":1715,"path":17,"seo":1716,"stem":18,"__hash__":1717},"docs\u002F1.getting-started\u002F2.upgrading.md",{"type":78,"value":79,"toc":1681},"minimark",[80,85,89,94,116,120,134,149,153,156,197,210,214,357,361,380,384,391,394,398,403,406,417,421,441,451,455,466,468,472,476,479,501,505,510,524,529,702,705,720,726,730,734,759,763,766,873,876,886,888,892,895,898,911,914,917,928,932,1064,1066,1078,1082,1391,1393,1411,1414,1417,1420,1464,1468,1472,1475,1504,1507,1517,1519,1523,1529,1532,1674,1677],[81,82,84],"h2",{"id":83},"from-v41-to-v42","From v4.1 to v4.2",[86,87,88],"p",{},"4.2 adds the Modern board, an opt-in board with its own styling contract. Existing boards keep working unchanged. It needs no migration, no config key and no env var.",[90,91,93],"h3",{"id":92},"requirements","Requirements",[95,96,97,101,104],"ul",{},[98,99,100],"li",{},"Filament 5, PHP 8.3 and Laravel 12, as in 4.1.",[98,102,103],{},"Groupings use window functions: MySQL 8, MariaDB 10.2, PostgreSQL, SQLite 3.25 or SQL Server. Boards without groupings have no new requirement.",[98,105,106,107,111,112,115],{},"Hard column limits take a cache lock, so use a store that every server shares, such as redis, memcached, database or dynamodb. The ",[108,109,110],"code",{},"array"," store locks per process and the ",[108,113,114],{},"null"," store never blocks. Under either, two simultaneous drops can both pass a limit.",[90,117,119],{"id":118},"upgrade-steps","Upgrade steps",[121,122,123,128],"ol",{},[98,124,125],{},[108,126,127],{},"composer update relaticle\u002Fflowforge",[98,129,130,133],{},[108,131,132],{},"php artisan filament:assets",", which publishes the Modern script and the Modern stylesheet. The page head links the stylesheet, so a missing publish leaves Modern boards unstyled.",[86,135,136,137,140,141,144,145,148],{},"Nothing else changes for a board that keeps its current ",[108,138,139],{},"BoardPage",", ",[108,142,143],{},"BoardResourcePage"," or ",[108,146,147],{},"InteractsWithBoard"," import.",[90,150,152],{"id":151},"opting-in","Opting in",[86,154,155],{},"Change one import on the page you want to move:",[157,158,163],"pre",{"className":159,"code":160,"language":161,"meta":162,"style":162},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Relaticle\\Flowforge\\Modern\\BoardResourcePage;\n","php","",[108,164,165],{"__ignoreMap":162},[166,167,170,174,178,182,185,187,190,192,194],"span",{"class":168,"line":169},"line",1,[166,171,173],{"class":172},"sbssI","use",[166,175,177],{"class":176},"sTEyZ"," Relaticle",[166,179,181],{"class":180},"sMK4o","\\",[166,183,184],{"class":176},"Flowforge",[166,186,181],{"class":180},[166,188,189],{"class":176},"Modern",[166,191,181],{"class":180},[166,193,143],{"class":176},[166,195,196],{"class":180},";\n",[86,198,199,202,203,205,206,209],{},[108,200,201],{},"Relaticle\\Flowforge\\Modern\\BoardPage"," replaces ",[108,204,139],{},", and ",[108,207,208],{},"Relaticle\\Flowforge\\Modern\\Concerns\\InteractsWithBoard"," replaces the standalone trait. Opt in per page. A classic and a Modern board can live in one app.",[90,211,213],{"id":212},"what-changes-on-a-modern-board","What changes on a Modern board",[95,215,216,267,280,283,289,305,319,322,346],{},[98,217,218,219,222,223,225,226,229,230,233,234,237,238,144,241,244,245,248,249,252,253,256,257,260,261,266],{},"Overrides of ",[108,220,221],{},"moveCard()"," move to hooks. ",[108,224,221],{}," returns ",[108,227,228],{},"bool"," and takes ",[108,231,232],{},"?string $fromLaneId"," and ",[108,235,236],{},"?string $toLaneId",", so on a subclass of ",[108,239,240],{},"Modern\\BoardPage",[108,242,243],{},"Modern\\BoardResourcePage"," an override with the classic ",[108,246,247],{},"void"," signature is a fatal error. A standalone class that uses the Modern trait and declares its own ",[108,250,251],{},"moveCard(): void"," gets no error, and the override silently replaces the Modern method, so refused moves never revert the card. Remove the override. Put checks in ",[108,254,255],{},"authorizeCardMove()"," and custom writes in ",[108,258,259],{},"persistCardMove()",". See ",[262,263,265],"a",{"href":264},"\u002Fessentials\u002Fintegration-patterns#custom-card-movement-logic","Custom Card Movement Logic",".",[98,268,269,233,272,275,276,279],{},[108,270,271],{},"calculateAndUpdatePosition()",[108,273,274],{},"calculateAndUpdatePositionWithRetry()"," take a trailing ",[108,277,278],{},"?array $laneMove = null",". An override with the classic signature is a fatal error on a Modern page subclass. A standalone class that uses the Modern trait gets no error, and its method silently replaces the Modern one. Prefer the two hooks.",[98,281,282],{},"A move to a column the board does not show, or to a card its query no longer returns, is refused with a notification and the card returns.",[98,284,285,288],{},[108,286,287],{},"createCardAction()",", column limits, column summaries and groupings work on Modern boards only. A classic board ignores them.",[98,290,291,292,140,295,140,298,140,301,304],{},"The card components (",[108,293,294],{},"CardTitle",[108,296,297],{},"CardTag",[108,299,300],{},"CardMeta",[108,302,303],{},"CardAvatar",") are designed for Modern boards. On a classic board their look is not guaranteed.",[98,306,307,308,311,312,315,316,266],{},"Modern markup carries ",[108,309,310],{},"ff-*"," classes. CSS written for ",[108,313,314],{},"flowforge-*"," classes does not reach a Modern board. Restyle through the ",[262,317,318],{"href":57},"design system",[98,320,321],{},"Dragging uses SortableJS fallback mode, so the dragged card is a real element. CSS or code that targeted native drag states stops working.",[98,323,324,325,140,328,140,331,334,335,338,339,144,342,345],{},"The paging properties (",[108,326,327],{},"$columnCardLimits",[108,329,330],{},"$visibleLaneCount",[108,332,333],{},"$cellCardLimits",") are ",[108,336,337],{},"#[Locked]",". Call ",[108,340,341],{},"loadMoreItems()",[108,343,344],{},"loadAllItems()"," instead of writing them from the browser.",[98,347,348,349,352,353,356],{},"Modern views live under ",[108,350,351],{},"flowforge::modern.*",". A classic view you published to ",[108,354,355],{},"resources\u002Fviews\u002Fvendor\u002Fflowforge\u002Flivewire"," keeps serving classic boards and never reaches a Modern board.",[90,358,360],{"id":359},"other-changes","Other changes",[95,362,363,370,377],{},[98,364,365,366,369],{},"New lang keys exist in the en, de, es and nl files. The classic ",[108,367,368],{},"no_cards_in_column"," key stays.",[98,371,372,373,266],{},"A board query that joins another table must select the base table's columns explicitly. See ",[262,374,376],{"href":375},"\u002Fessentials\u002Fintegration-patterns#joined-board-queries","Joined board queries",[98,378,379],{},"A classic move no longer fails on PostgreSQL when the board query outer-joins its column value.",[90,381,383],{"id":382},"known-limitation","Known limitation",[86,385,386,387,390],{},"The first ",[108,388,389],{},"wire:navigate"," visit to a Modern board from any page that has not loaded the Modern stylesheet can show the board unstyled for a moment, because Livewire does not wait for new head stylesheets. Full page loads and repeat visits are styled from the first frame.",[392,393],"hr",{},[81,395,397],{"id":396},"from-v3x-to-v4x","From v3.x to v4.x",[399,400,402],"callout",{"type":401},"info","v4.x upgrades Filament support from 4.x to 5.x. No database or code changes required.",[90,404,93],{"id":405},"requirements-1",[95,407,408,411,414],{},[98,409,410],{},"Filament 5.x (was 4.x)",[98,412,413],{},"PHP 8.3+",[98,415,416],{},"Laravel 12+",[90,418,420],{"id":419},"upgrade-steps-1","Upgrade Steps",[157,422,426],{"className":423,"code":424,"language":425,"meta":162,"style":162},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","composer require relaticle\u002Fflowforge:^4.0\n","bash",[108,427,428],{"__ignoreMap":162},[166,429,430,434,438],{"class":168,"line":169},[166,431,433],{"class":432},"sBMFI","composer",[166,435,437],{"class":436},"sfazB"," require",[166,439,440],{"class":436}," relaticle\u002Fflowforge:^4.0\n",[86,442,443,444,450],{},"Review the ",[262,445,449],{"href":446,"rel":447},"https:\u002F\u002Ffilamentphp.com\u002Fdocs\u002F5.x\u002Fupgrade-guide",[448],"nofollow","Filament 5 Upgrade Guide"," if you customized Filament components.",[90,452,454],{"id":453},"no-changes-required","No Changes Required",[95,456,457,460,463],{},[98,458,459],{},"Board configuration API unchanged",[98,461,462],{},"Position column type unchanged",[98,464,465],{},"All existing board code works without modification",[392,467],{},[81,469,471],{"id":470},"from-v2x-to-v4x","From v2.x to v4.x",[399,473,475],{"type":474},"warning","This covers all breaking changes from v2.x directly to v4.x. Includes database migration.",[90,477,93],{"id":478},"requirements-2",[95,480,481,484,487,490],{},[98,482,483],{},"PHP 8.3+ (was 8.2+)",[98,485,486],{},"Laravel 12+ (was 10+)",[98,488,489],{},"Filament 5.x (was 3.x)",[98,491,492,496,497,500],{},[493,494,495],"strong",{},"New:"," ",[108,498,499],{},"ext-bcmath"," PHP extension",[90,502,504],{"id":503},"high-impact-changes","High Impact Changes",[506,507,509],"h4",{"id":508},"position-column-type-changed","Position Column Type Changed",[86,511,512,513,516,517,520,521,266],{},"The ",[108,514,515],{},"flowforgePositionColumn()"," macro now creates ",[108,518,519],{},"DECIMAL(20,10)"," instead of ",[108,522,523],{},"VARCHAR",[86,525,526],{},[493,527,528],{},"Quick upgrade (resets card order):",[157,530,532],{"className":159,"code":